{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stash",
  "mainBinaryName": "stash",
  "version": "2.0.0",
  "identifier": "stash",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}
