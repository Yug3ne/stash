{
  "name": "appimage-install-tui",
  "version": "0.1.0",
  "description": "Terminal UI for appimage-install",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "appimage-install-tui": "dist/cli.js"
  },
  "scripts": {
    "start": "bun source/cli.tsx",
    "build": "bun build source/cli.tsx --outdir dist --target bun --minify",
    "dev": "bun --watch source/cli.tsx"
  },
  "dependencies": {
    "ink": "^5.2.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/react": "^18.3.18",
    "react-devtools-core": "^7.0.1",
    "typescript": "^5.8.2"
  }
}
